# Copy this file to .env and change only what you need.
# .env is local configuration. Do not commit it.

# Preferred architecture:
#   Primary  = ANSWER_PROVIDER (default gemini)
#   Fallback = the other free provider on HTTP 429
ANSWER_PROVIDER=gemini

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Rate-limit controls for eval / ask.
# Delay reduces RPM collisions; it does NOT increase daily request quotas.
# Daily-quota 429s skip local retries and fall over to the other provider.
LLM_REQUEST_DELAY_S=8
LLM_MAX_RETRIES=3
# Successful LLM answers are cached under data/llm_cache.json (gitignored).

# Ollama is not an active ANSWER_PROVIDER option. Kept only so the local-CPU
# latency experiment in EXPERIMENTS.md stays reproducible.
OLLAMA_MODEL=llama3.2:latest
OLLAMA_URL=http://localhost:11434/api/chat

# Dense index. A relative path is resolved from the project root.
CHROMA_DIR=data/chroma_db

# Filing desks each role may retrieve. Values are comma-separated desk names
# stored on each chunk. Access is enforced in retrieval, not in the prompt.
# The lead role lists every desk.
DESK_CONSUMER=consumer
DESK_HEALTH_INDUSTRIALS=health_industrials
DESK_TECH_TELECOM=tech_telecom
DESK_LEAD=consumer,health_industrials,tech_telecom
