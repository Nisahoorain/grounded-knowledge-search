# Copy this file to .env and change only what you need.
# .env is local configuration. Do not commit it.

# Model used by `ask` when the question is not answered directly from a filing line.
# Switch models by changing this one variable. Ollama must be running at OLLAMA_URL.
OLLAMA_MODEL=llama3.2:latest
OLLAMA_URL=http://localhost:11434/api/chat

# Dense index. A relative path is resolved from the project root.
CHROMA_DIR=data/chroma_db

# Filing desks each role may retrieve. Values are comma-separated desk names
# stored on each chunk. Access is enforced in retrieval, not in the prompt.
# The lead role lists every desk.
DESK_CONSUMER=consumer
DESK_HEALTH_INDUSTRIALS=health_industrials
DESK_TECH_TELECOM=tech_telecom
DESK_LEAD=consumer,health_industrials,tech_telecom
